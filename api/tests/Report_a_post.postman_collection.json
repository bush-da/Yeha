		{
			"name": "New Request",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.request.headers.add({",
							"    key: \"Authorization\",",
							"    value: `Bearer ${pm.globals.get(\"authToken\")}`",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Report submitted successfully\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.equal(\"Report submitted successfully.\");",
							"    pm.expect(jsonData.report).to.have.property(\"id\");",
							"    pm.expect(jsonData.report.reason).to.equal(\"Spam content\");",
							"    pm.expect(jsonData.report.post_id).to.exist;",
							"    pm.expect(jsonData.report.reporter_id).to.exist;",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"post_id\": \"{{postId}}\",\n    \"reason\": \"Spam content\"\n}\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
