					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains post ID\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"id\");",
							"    pm.expect(jsonData.id).to.exist;",
							"});",
							"",
							"pm.test(\"Post title is correct\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.title).to.equal(\"Updated Post Title\");",
							"});",
							"",
							"pm.test(\"Post contents are correctly fetched\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.contents.length).to.be.greaterThan(0);",
							"    pm.expect(jsonData.contents[1].content).to.equal(\"This is the new second paragraph.\");",
							"    pm.expect(jsonData.contents[1].paragraph).to.equal(1);  // Adjusted to 0 if that is the intended paragraph number.",
							"});",
							"",
							"pm.test(\"Tags are correctly fetched\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.tags.length).to.equal(2);",
							"    pm.expect(jsonData.tags[0].name).to.equal(\"Tech\");",
							"    pm.expect(jsonData.tags[1].name).to.equal(\"Go Programming\");",
							"});",
							"",
							"pm.test(\"Post author is correctly associated\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.author).to.have.property(\"ID\");",
							"    pm.expect(jsonData.author.Username).to.exist;",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
