		{
			"name": "Fetch a post",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.request.headers.add({",
							"    key: \"Authorization\",",
							"    value: `Bearer ${pm.collectionVariables.get(\"authToken\")}`",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains post ID\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.post).to.have.property(\"id\");",
							"    pm.expect(jsonData.post.id).to.exist;",
							"});",
							"",
							"pm.test(\"Post title is correct\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.post.title).to.equal(\"My First Post\");",
							"});",
							"",
							"pm.test(\"Post contents are correctly fetched\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.post.contents.length).to.be.greaterThan(0);",
							"    pm.expect(jsonData.post.contents[0].content).to.equal(\"This is the first paragraph of my post.\");",
							"    pm.expect(jsonData.post.contents[0].paragraph).to.equal(0);",
							"});",
							"",
							"pm.test(\"Tags are correctly fetched\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.post.tags.length).to.equal(2);",
							"    pm.expect(jsonData.post.tags[0].name).to.equal(\"Tech\");",
							"    pm.expect(jsonData.post.tags[1].name).to.equal(\"Web Development\");",
							"});",
							"",
							"pm.test(\"Post author is correctly associated\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.post.author).to.have.property(\"ID\");",
							"    pm.expect(jsonData.post.author.Username).to.exist;",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
