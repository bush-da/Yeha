		{
			"name": "Fetch all posts",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.request.headers.add({",
							"    key: \"Authorization\",",
							"    value: `Bearer ${pm.collectionVariables.get(\"authToken\")}`",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is an array of posts\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an(\"array\");",
							"});",
							"",
							"pm.test(\"Each post contains essential fields\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);",
							"",
							"    jsonData.forEach(post => {",
							"        pm.expect(post).to.have.property(\"id\");",
							"        pm.expect(post).to.have.property(\"title\");",
							"        pm.expect(post).to.have.property(\"contents\");",
							"        pm.expect(post).to.have.property(\"tags\");",
							"        pm.expect(post).to.have.property(\"author\");",
							"    });",
							"});",
							"",
							"pm.test(\"Contents for posts are correctly structured\", function () {",
							"    const jsonData = pm.response.json();",
							"",
							"    jsonData.forEach(post => {",
							"        pm.expect(post.contents).to.be.an(\"array\");",
							"        post.contents.forEach(content => {",
							"            pm.expect(content).to.have.property(\"content\");",
							"            pm.expect(content).to.have.property(\"paragraph\");",
							"        });",
							"    });",
							"});",
							"",
							"pm.test(\"Tags for posts are correctly structured\", function () {",
							"    const jsonData = pm.response.json();",
							"",
							"    jsonData.forEach(post => {",
							"        pm.expect(post.tags).to.be.an(\"array\");",
							"        post.tags.forEach(tag => {",
							"            pm.expect(tag).to.have.property(\"name\");",
							"        });",
							"    });",
							"});",
							"",
							"pm.test(\"Authors for posts are correctly structured\", function () {",
							"    const jsonData = pm.response.json();",
							"",
							"    jsonData.forEach(post => {",
							"        pm.expect(post.author).to.have.property(\"ID\");",
							"        pm.expect(post.author).to.have.property(\"Username\");",
							"    });",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
